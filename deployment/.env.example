REM ============================================================
REM This is a REFERENCE list of environment variables the project
REM understands. Copy this file to deployment\mysql.local.bat and
REM replace every placeholder. start_waitress.bat and backup.bat load
REM that ignored local file automatically. Alternatively, set permanent
REM Windows environment variables via:
REM   Control Panel -> System -> Advanced system settings
REM   -> Environment Variables
REM
REM See deployment\README_DEPLOYMENT.md for the full explanation
REM of each one.
REM ============================================================

REM --- Core Django settings ---
set DJANGO_SECRET_KEY=replace-with-a-long-random-string
set DJANGO_DEBUG=False
set DJANGO_ALLOWED_HOSTS=192.168.1.10,localhost,127.0.0.1
set DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000
set LAN_SERVER_IP=192.168.1.10

REM --- Database: leave unset (or DB_ENGINE=sqlite) for SQLite. ---
REM --- Set DB_ENGINE=mysql to use MySQL/MariaDB instead.       ---
set DB_ENGINE=mysql
set DB_NAME=examsystem
set DB_USER=examsystem_user
set DB_PASSWORD=your-password-here
set DB_HOST=127.0.0.1
set DB_PORT=3306

REM --- Optional: local ZIP server started by start_waitress.bat. ---
set MYSQLD_EXE=C:\MySQL\mysql-8.4.11-winx64\bin\mysqld.exe
set MYSQLD_CONFIG=C:\ProgramData\MySQL\ExamSystem84\my.ini
